NODE_ENV=development
PORT=3000

# Local Postgres (docker-compose uses 5433)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=starautos
DATABASE_PASSWORD=starautos
DATABASE_NAME=star_autos

# Production (Neon / Render): prefer DATABASE_URL (SSL enabled for neon.tech)
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change-me-in-production-use-long-secret
JWT_EXPIRES_IN=7d
SEED_ON_START=true
# Set true once to wipe all business data (products/customers/bills)
SEED_RESET=false
CORS_ORIGIN=http://localhost:5173
# First production boot: true so TypeORM creates tables on Neon
TYPEORM_SYNC=false
